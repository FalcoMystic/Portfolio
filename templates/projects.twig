{% extends 'index.twig' %}

{% block main %}
<h1>Mes Projets</h1>

<div class="projects-list">
	{% for projet in projets %}
		<div class="project-card">
			<h3>{{ projet.titre }}</h3>
			<p class="description">{{ projet.description }}</p>
			<p class="date">{{ projet.date }}</p>
			<a href="projet.php?id={{ projet.id }}" class="btn-details">Voir les détails</a>
		</div>
	{% endfor %}
</div>
{% endblock %}