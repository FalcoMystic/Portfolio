{% extends 'index.twig' %}
{% block main %}
	<h1 class="title-projects-page">
		Mes Projets
	</h1>
	<div class="list-projects">
		{% for project in projects %}
			<div class="card-projects">
				<div class="top-part-projects">
					<h2 class="title-projects">
						{{ project.titre }}
					</h2>
					<p class="date-projects">
						{{ project.date }}
					</p>
				</div>
				<div class="bottom-part-projects">
					<p class="desc-projects">
						{{ project.desc_courte }}
					</p>
					<a href="project.php?id={{ project.id }}" class="details-project">
						En savoir plus
					</a>
				</div>
			</div>
		{% endfor %}
	</div>
{% endblock %}
