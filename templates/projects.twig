{% extends 'index.twig' %}
{% block main %}
	<h1>
		Mes Projets
	</h1>
	<div	class="list-projects">
		{% for project in projects %}
			<div	class="card-project">
				<div	class="top-part-project">
					<h3>
						{{ project.titre }}
					</h3>
					<p	class="date-project">
						{{ project.date }}
					</p>
				</div>
				<p	class="desc-project">
					{{ project.description }}
				</p>
				<a	href="project.php?id={{ project.id }}"	class="details-project">
					En savoir plus
				</a>
			</div>
		{% endfor %}
	</div>
{% endblock %}
