<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="stylesheet" href="{{ asset("css/style.css")}}">
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>"> {% block stylesheets %}{% endblock %}
		{% block javascripts %}
			<script src="{{ asset('js/dropdown.js') }}" defer></script>
			<script src="{{ asset('js/menu_maison.js') }}" defer></script>

		{% endblock %}
	</head>
	<body>

		{% block header %}
			<header>
				<nav class="nav-menu">
					<a href="{{ path('home') }}">
						<img class="base-logo" src="{{ asset('img/logo.webp') }}" alt="logo">
					</a>
					<div class="nav-menu-flex">
						<a href="{{ path('home') }}">Accueil</a>
						<a href="{{ path('parcours') }}">Parcours</a>
						{% if app.user %}
							<div class="dropdown">
								<a class="dropbtn" onclick="myFunction()">
									Compte
									<img class="icon-dropdown" src="{{ asset('svg/down_fill.svg') }}" alt="Icone iles">
								</a>

								<div class="dropdown-content" id="myDropdown">
									<a href="{{ path('app_profile') }}">Mon profil</a>
									<a href="{{ path('app_logout') }}">Déconnexion</a>
								</div>
							</div>
						{% else %}
							<a href="{{ path('app_login') }}">Connexion</a>
						{% endif %}
					</div>
				</nav>


				<div class="dropdown">
					<a class="dropbtn">
						<div class="menu-burger" id="menu_maison">
							<img class="icon-maison icon-maison--btn" src="{{ asset('svg/home_4_fill.svg') }}" alt="Icone maison">
						</div>
					</a>


					<div class="dropdown-content mobile-menu-dropdown" id="mobileMenuDropdown">

						<div class="groupe-icone">

							<div class="presentation-menu">
								<img class="icon-maison" src="{{ asset('svg/route.svg') }}" alt="Icone maison">
								<a class="texte-menu" href="{{ path('parcours') }}">Parcours</a>
							</div>

							<div class="presentation-menu">
								<img class="icon-maison icon-maison" src="{{ asset('svg/heart_line.svg') }}" alt="Icone maison">
								<a href="{{ path('app_profile') }}">
									Profil</a>
							</div>

							{% if app.user %}
								<div class="presentation-menu">
									<img class="icon-maison" src="{{ asset('svg/exit_fill.svg') }}" alt="Icone maison">
									<a href="{{ path('app_logout') }}">Déconnexion</a>
								</div>
							{% else %}
								<div class="presentation-menu">
									<img class="icon-maison" src="{{ asset('svg/user-connexion.svg') }}" alt="Icone maison">
									<a href="{{ path('app_login') }}">Connexion</a>
								</div>
							{% endif %}

							<div class="presentation-menu">
								<img class="icon-maison" src="{{ asset('svg/home_4_fill.svg') }}" alt="Icone maison">
								<a href="{{ path('home') }}">Accueil</a>
							</div>

						</div>
					</div>
				</div>
			</header>
			{% block banner %}{% endblock %}
		{% endblock %}

		<main>
			{% block body %}{% endblock %}
		</main>
		{% block footer %}
			<footer>
				<nav class="footer-menu">
					<a class="footer-link--desktop" href="{{ path('home') }}">Accueil</a>
					<a class="footer-link--desktop" href="{{ path('parcours') }}">Parcours</a>
					<a class="footer-link--desktop" href="{{ path('app_profile') }}">Compte</a>
					<a class="footer-link--legal" href="{{ path('mentions') }}">Mentions Légales</a>
					<a class="footer-link--legal" href="{{ path('conditions') }}">Conditions d'utilisations</a>
					<p class="footer-credits">Réalisé par Giangreco Toni, Wittmann Manoly et Nguyen Luan
					</p>
				</nav>
			</footer>
		{% endblock %}
	</body>
</html>
