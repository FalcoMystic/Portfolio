<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bibliothèque</title>
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    {% block stylesheet %}{% endblock %}
</head>

<body>
    <input type="checkbox" id="menu-toggle" />
    <header class="top-bar">
        <nav>
            <ul>
                <li><a href="index.php"><i class="bi bi-vinyl-fill"></i>33 Tours</a></li>
                <li><label for="menu-toggle" class="menu-icon"><i class="bi bi-list"></i></label></li>
            </ul>
        </nav>
    </header>

    <div class="fullscreen-menu">
        <div class="icon-vinyle"></div>
        <div class="menu-links">
            <a href="index.php">ACCUEIL</a>
            <a href="vinyles.php">VINYLES</a>
            <a href="artistes.php">ARTISTES</a>
            <a href="genres.php">GENRES</a>
            <a href="propos.php">A PROPOS</a>
            <a href="panier.php">PANIER</a>
        </div>
        <label for="menu-toggle" class="close-btn">&times;</label>
    </div>

    {% block banner %}
    <div class="banner">
        <h1 class="banner-text">33 Tours</h1>
    </div>
    {% endblock %}

    <main>
        {% block main %}

        <h2>Bibliothèque</h2>
        <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Magnam mollitia eaque optio et excepturi non iure quos odit
        ipsum dolor dolorum, atque consequuntur a eveniet quae, ad rerum repellendus minima!</p>
        <h2>Nos Vinyles du Week-end !</h2>
        <section>
            <div class="vinyle-part">
            {% for vinyle in vinyles %}
            <div class="vinyles">
            {% if vinyle.id_vinyle in [3, 11, 16] %}
            <img src="img/vinyles/{{ vinyle.couverture }}" alt="{{ vinyle.titre }}" />
            {% endif %}
            </div>
            {% endfor %}
            </div>
        </section>

        <section>
            {% for artiste in artistes %}
            {% if artiste.id_artiste in [2, 7, 10] %}
            <img src="img/artistes/{{ artiste.photo }}" alt="{{ artiste.nom }}" />
            {% endif %}
            {% endfor %}
        </section>

        <section>
            {% for genre in genres %}
            {% if genre.id_genre in [5, 12] %}
            <img src="img/genres/{{ genre.image }}" alt="{{ genre.nom }}" />
            {% endif %}
            {% endfor %}
        </section>
        {% endblock %}

    </main>
    <footer>

    </footer>
</body>

</html>